# ============================================================
#  Pintura Dump — configuración de servidor (Hostinger / LiteSpeed)
# ============================================================
#  Este archivo vive en `public/`, NO en `dist/`.
#  Vite copia `public/` tal cual dentro de `dist/` en cada build, así que
#  la configuración del servidor viaja SIEMPRE junto al deploy y queda
#  versionada en Git. Nada de config escondida en el panel web: si no está
#  en el repo, no existe.
#
#  Destino en el servidor: /public_html/.htaccess
# ============================================================


# ------------------------------------------------------------
#  1. Documento de entrada
# ------------------------------------------------------------
#  Hostinger crea un `default.php` de bienvenida en public_html. Apache
#  prioriza .php sobre .html, así que ese archivo TAPA el sitio. Se borra
#  del servidor, y además fijamos aquí la prioridad correcta.
DirectoryIndex index.html

#  Sin listado de directorios: /assets/ no debe ser navegable.
Options -Indexes


# ------------------------------------------------------------
#  2. URL canónica: HTTPS y sin www
# ------------------------------------------------------------
#  El <link rel="canonical"> del sitio apunta a https://pinturadump.com/
#  (sin www). El servidor debe respetar esa misma forma o Google indexa
#  variantes duplicadas.
#
#  Las reglas NO llevan el dominio escrito a mano: usan el host de la
#  petición. Así el sitio también funciona correcto en el dominio temporal
#  de Hostinger (*.hostingersite.com) antes de apuntar el DNS.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → sin www. Va PRIMERO y ya salta directo a https,
  # así http://www.dominio se resuelve en UN solo redirect, no en dos.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

#  NO hay fallback de SPA a propósito: esto es una landing de una sola
#  página con navegación por anclas (#artista, #obras, ...). No existe
#  enrutado de cliente, así que un redirect /* → /index.html sería ruido
#  y además convertiría cada 404 real en un falso 200.


# ------------------------------------------------------------
#  3. Compresión
# ------------------------------------------------------------
#  Solo formatos de texto. Comprimir webp/woff2/mp4 quema CPU sin ganar
#  un solo byte: ya vienen comprimidos.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ------------------------------------------------------------
#  4. Caché — la parte delicada
# ------------------------------------------------------------
#  En /assets/ conviven DOS tipos de archivo y no se cachean igual:
#
#   a) Con hash de Vite  → index-C4EAYrNX.js, hero-...-Bvqj-7-b.webp
#      El nombre cambia cuando cambia el contenido. Se cachean para
#      siempre sin riesgo: un archivo nuevo llega con nombre nuevo.
#
#   b) Copiados de public/ → catalogo-pintura-dump.pdf,
#      videos/trailer-web-hd.mp4, los íconos, og-pintura-dump.jpg
#      Conservan su nombre entre versiones. Si se cachean un año y luego
#      se reemplaza el video, NADIE vuelve a ver el nuevo. Caché corta.
<IfModule mod_headers.c>

  # (a) Huella de Vite: nombre-HASH8.extensión → inmutable, un año.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|jpe?g|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # (b) Nombre estable: se revalida a diario. Reemplazarlos surte efecto
  #     al día siguiente como máximo, no en un año.
  <FilesMatch "\.(pdf|mp4|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Los íconos son PNG sin hash: no los alcanza la regla (a) y necesitan la
  # caché corta de (b) para poder reemplazarlos si el cliente cambia su marca.
  <FilesMatch "^(favicon-.+|apple-touch-icon|icon-.+|og-pintura-dump)\.(png|jpe?g)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # El HTML nunca se cachea: es quien apunta a los assets con hash nuevos.
  # Si se cachea, el deploy simplemente no se ve.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # robots.txt y sitemap.xml: cortos, para poder corregirlos rápido.
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Encabezados de seguridad mínimos y sin efectos colaterales.
  # (Deliberadamente SIN Content-Security-Policy: exige pruebas propias
  #  y mal puesta rompe GSAP y las fuentes.)
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>


# ------------------------------------------------------------
#  5. Tipos MIME
# ------------------------------------------------------------
#  LiteSpeed moderno ya los reconoce, pero declararlos es gratis y evita
#  que una imagen se descargue en vez de mostrarse o que una fuente se
#  sirva como texto plano.
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType font/woff                   .woff
  AddType video/mp4                   .mp4
  AddType application/pdf             .pdf
  AddType application/manifest+json   .webmanifest
</IfModule>
